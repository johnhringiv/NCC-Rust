{
  "name": "tokens",
  "scopeName": "source.tokens",
  "_comment": "TextMate grammar for NCC's `--lex` output (`Processed tokens: [...]`). Variant names mirror `Token` in src/lexer.rs and are printed via Rust's `{:?}` Debug. Keep in sync with the `Token` enum.",
  "patterns": [
    {
      "comment": "Leading 'Processed tokens:' header and comment lines",
      "name": "comment.line.tokens",
      "match": "^\\s*#.*$"
    },
    {
      "comment": "Identifier(\"name\") — carries the source spelling",
      "name": "entity.name.function.tokens",
      "match": "\\bIdentifier\\(\"[^\"]*\"\\)"
    },
    {
      "comment": "Constant tokens: ConstantInt/Long/UnsignedInt/UnsignedLong/Double(\"...\")",
      "name": "constant.numeric.tokens",
      "match": "\\bConstant(?:UnsignedLong|UnsignedInt|Long|Int|Double)\\(\"[^\"]*\"\\)"
    },
    {
      "comment": "Keywords — every *Keyword variant of Token",
      "name": "keyword.control.tokens",
      "match": "\\b(IntKeyword|VoidKeyword|ReturnKeyword|IfKeyword|ElseKeyword|GotoKeyword|DoKeyword|WhileKeyword|ForKeyword|BreakKeyword|ContinueKeyword|SwitchKeyword|DefaultKeyword|CaseKeyword|StaticKeyword|ExternKeyword|LongKeyword|SignedKeyword|UnsignedKeyword|DoubleKeyword)\\b"
    },
    {
      "comment": "Operators (compound *Assign names listed implicitly via word boundaries)",
      "name": "keyword.operator.tokens",
      "match": "\\b(BitwiseComplement|Negation|Plus|Asterisk|Division|Modulus|BitwiseAndAssign|BitwiseOrAssign|BitwiseXOrAssign|BitwiseLeftShiftAssign|BitwiseRightShiftAssign|BitwiseAnd|BitwiseOr|BitwiseXOr|BitwiseLeftShift|BitwiseRightShift|LogicalNot|LogicalAnd|LogicalOr|Equal|NotEqual|LessThanOrEqual|GreaterThanOrEqual|LessThan|GreaterThan|Assignment|PlusAssign|MinusAssign|AsteriskAssign|DivisionAssign|ModulusAssign|Decrement|Increment|QuestionMark|Colon)\\b"
    },
    {
      "comment": "Delimiters and punctuation",
      "name": "punctuation.tokens",
      "match": "\\b(OpenParen|CloseParen|OpenBrace|CloseBrace|Semicolon|Comma)\\b"
    },
    {
      "comment": "List brackets / commas around the token vector",
      "name": "punctuation.bracket.tokens",
      "match": "[\\[\\],]"
    }
  ]
}
